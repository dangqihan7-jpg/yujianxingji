AMAP_JS_KEY=
AMAP_SECURITY_JS_CODE=
AMAP_WEB_SERVICE_KEY=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_MAX_TOKENS=
LLM_PUBLIC_DEMO=
LLM_DAILY_LIMIT=
LLM_CLIENT_DAILY_LIMIT=
# 图片理解 WebSocket 服务（wss://spark-api.cn-huabei-1.xf-yun.com/v2.1/image）所在应用的三件套，从控制台该应用复制；不填写真实密钥到仓库
XF_VISION_APPID=
XF_VISION_APIKEY=
XF_VISION_APISECRET=
# 可选：imagev3（高级版，默认）或 general（基础版），按该应用实际开通的版本填
XF_VISION_DOMAIN=
TRAVEL_DEV_PORT=
# 独立服务器部署时设为 true，启用自建账号登录（注册/登录/会话），替代平台注入身份
STANDALONE_AUTH=

# 语音听写（流式版）应用三件套，仅配置到服务端，不填写真实值到仓库
XF_ASR_APPID=
XF_ASR_APIKEY=
XF_ASR_APISECRET=
